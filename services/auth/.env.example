# Auth service — copy to .env for local runs.

SERVICE_NAME=smarthire-auth
ENVIRONMENT=local
DEBUG=true

# Auth owns its own database.
DATABASE_URL=postgresql+asyncpg://smarthire:smarthire@localhost:5433/auth

# RS256 keys. Auth signs with the private key; all services verify with public.
# Generate with: ../../scripts/generate-keys.sh  (writes ../../keys/)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=../../keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

LOG_LEVEL=INFO
