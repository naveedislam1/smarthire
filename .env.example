# Copy to `.env` and adjust as needed. Never commit real secrets.

# App
APP_NAME=SmartHire
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (async SQLAlchemy URL)
# Matches the docker-compose Postgres service credentials.
DATABASE_URL=postgresql+asyncpg://smarthire:smarthire@localhost:5432/smarthire

# Auth / JWT — MUST override SECRET_KEY with a strong random value outside dev.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO
