# Copy to `.env` and adjust as needed. Never commit real secrets.

# App
APP_NAME=SmartHire
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (async SQLAlchemy URL)
# Matches the docker-compose Postgres service credentials.
DATABASE_URL=postgresql+asyncpg://smarthire:smarthire@localhost:5432/smarthire

# Logging
LOG_LEVEL=INFO
