{
  "info": {
    "name": "SmartHire — Week 1 API",
    "description": "Core job & candidate management endpoints. Import into Postman: File → Import → this file. Set the `baseUrl` collection variable if your server is not on http://localhost:8000. Requests auto-capture jobId / candidateId into collection variables so you can run them in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "jobId", "value": "" },
    { "key": "candidateId", "value": "" }
  ],
  "item": [
    {
      "name": "Meta",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Service info",
          "request": { "method": "GET", "url": "{{baseUrl}}/" }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.code === 201);",
                  "pm.collectionVariables.set('jobId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"description\": \"Build and scale hiring services.\",\n  \"location\": \"Remote\",\n  \"employment_type\": \"full_time\",\n  \"required_skills\": [\"python\", \"fastapi\", \"postgresql\"],\n  \"hiring_stages\": [\"Screening\", \"Interview\", \"Offer\"]\n}"
            }
          }
        },
        {
          "name": "List jobs",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/jobs?limit=20&offset=0" }
        },
        {
          "name": "List published jobs",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/jobs?status_filter=published" }
        },
        {
          "name": "Get job",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}" }
        },
        {
          "name": "Update job",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Senior Backend Engineer\",\n  \"required_skills\": [\"python\", \"fastapi\", \"kafka\"]\n}" }
          }
        },
        {
          "name": "Publish job",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}/publish" }
        },
        {
          "name": "Delete job",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}" }
        }
      ]
    },
    {
      "name": "Candidates",
      "item": [
        {
          "name": "Register candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.code === 201);",
                  "pm.collectionVariables.set('candidateId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/candidates",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ada@example.com\",\n  \"full_name\": \"Ada Lovelace\",\n  \"phone\": \"+1-555-0100\"\n}" }
          }
        },
        {
          "name": "List candidates",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/candidates?limit=20&offset=0" }
        },
        {
          "name": "Get candidate",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}" }
        },
        {
          "name": "Update candidate",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}",
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+1-555-9999\"\n}" }
          }
        },
        {
          "name": "Upsert candidate profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}/profile",
            "body": { "mode": "raw", "raw": "{\n  \"headline\": \"Mathematician & first programmer\",\n  \"skills\": [\"mathematics\", \"algorithms\"],\n  \"experience_years\": 10,\n  \"resume_url\": \"https://example.com/resume.pdf\",\n  \"bio\": \"Pioneer of computing.\"\n}" }
          }
        },
        {
          "name": "Get candidate profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}/profile" }
        },
        {
          "name": "Delete candidate",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}" }
        }
      ]
    }
  ]
}
