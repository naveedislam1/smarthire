{
  "info": {
    "name": "SmartHire — Week 1 API",
    "description": "SmartHire microservices — all requests go through the API GATEWAY (default http://localhost:8080). The gateway proxies /api/v1/{auth,candidates,jobs,applications}/* to each service.\n\nSETUP: File → Import → this file. Credentials live in the collection variables (recruiterEmail/recruiterPassword, candidateEmail/candidatePassword) — edit them under the collection's Variables tab.\n\nUSAGE: run 'Auth → Register recruiter', then 'Auth → Login as recruiter' (stores accessToken + refreshToken automatically). Every other request inherits Bearer auth. Set `baseUrl` if the gateway is not on http://localhost:8080.\n\nAPPLY FLOW: create a Candidate (Candidates folder) and a Job, publish the job (202 → Temporal drives it to 'ready'), then Apply (Applications). DEFAULT CREDS — recruiter: recruiter@example.com / password123 · candidate: user@example.com / password123. There is no pre-seeded user; register creates them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "recruiterEmail", "value": "recruiter@example.com" },
    { "key": "recruiterPassword", "value": "password123" },
    { "key": "candidateEmail", "value": "user@example.com" },
    { "key": "candidatePassword", "value": "password123" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "candidateId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register recruiter",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{recruiterPassword}}\",\n  \"full_name\": \"Rita Recruiter\",\n  \"role\": \"recruiter\"\n}" }
          }
        },
        {
          "name": "Register candidate",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\",\n  \"full_name\": \"Cara Candidate\",\n  \"role\": \"candidate\"\n}" }
          }
        },
        {
          "name": "Login as recruiter (stores tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', () => pm.response.code === 200);",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', b.access_token);",
                  "pm.collectionVariables.set('refreshToken', b.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{recruiterEmail}}" },
                { "key": "password", "value": "{{recruiterPassword}}" }
              ]
            }
          }
        },
        {
          "name": "Login as candidate (stores tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', () => pm.response.code === 200);",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', b.access_token);",
                  "pm.collectionVariables.set('refreshToken', b.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{candidateEmail}}" },
                { "key": "password", "value": "{{candidatePassword}}" }
              ]
            }
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/me" }
        }
      ]
    },
    {
      "name": "Meta",
      "item": [
        { "name": "Gateway health", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/health" } }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create job (recruiter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.code === 201);",
                  "pm.collectionVariables.set('jobId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"description\": \"Build and scale hiring services.\",\n  \"location\": \"Remote\",\n  \"employment_type\": \"full_time\",\n  \"required_skills\": [\"python\", \"fastapi\", \"postgresql\"],\n  \"hiring_stages\": [\"Screening\", \"Interview\", \"Offer\"]\n}"
            }
          }
        },
        { "name": "List jobs", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/jobs?limit=20&offset=0" } },
        { "name": "List published jobs", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/jobs?status_filter=published" } },
        { "name": "Get job", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}" } },
        {
          "name": "Update job (recruiter)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Senior Backend Engineer\",\n  \"required_skills\": [\"python\", \"fastapi\", \"kafka\"]\n}" }
          }
        },
        { "name": "Publish job (recruiter, 202 → processing)", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}/publish" } },
        { "name": "Delete job (recruiter)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}" } }
      ]
    },
    {
      "name": "Applications",
      "description": "Apply as a candidate. Job must be published/ready first (publish it, then wait for the worker to move it to 'ready').",
      "item": [
        {
          "name": "Apply to job (candidate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.code === 201);",
                  "pm.collectionVariables.set('applicationId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "description": "Optional: makes retries safe" }
            ],
            "url": "{{baseUrl}}/api/v1/applications",
            "body": { "mode": "raw", "raw": "{\n  \"job_id\": \"{{jobId}}\",\n  \"candidate_id\": \"{{candidateId}}\"\n}" }
          }
        },
        { "name": "List applications", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/applications?limit=20&offset=0" } },
        { "name": "Get application", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}" } },
        {
          "name": "Advance stage (recruiter)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/stage",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"screening\"\n}" }
          }
        },
        { "name": "Withdraw (candidate)", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/withdraw" } }
      ]
    },
    {
      "name": "Candidates",
      "item": [
        {
          "name": "Register candidate resource",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.code === 201);",
                  "pm.collectionVariables.set('candidateId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/candidates",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ada@example.com\",\n  \"full_name\": \"Ada Lovelace\",\n  \"phone\": \"+1-555-0100\"\n}" }
          }
        },
        { "name": "List candidates (recruiter)", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/candidates?limit=20&offset=0" } },
        { "name": "Get candidate", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}" } },
        {
          "name": "Update candidate",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}",
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+1-555-9999\"\n}" }
          }
        },
        {
          "name": "Upsert candidate profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}/profile",
            "body": { "mode": "raw", "raw": "{\n  \"headline\": \"Mathematician & first programmer\",\n  \"skills\": [\"mathematics\", \"algorithms\"],\n  \"experience_years\": 10,\n  \"resume_url\": \"https://example.com/resume.pdf\",\n  \"bio\": \"Pioneer of computing.\"\n}" }
          }
        },
        { "name": "Get candidate profile", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}/profile" } },
        { "name": "Delete candidate", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/candidates/{{candidateId}}" } }
      ]
    }
  ]
}
